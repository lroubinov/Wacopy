# העתיקו קובץ זה בשם .env לפני יצירת הפרויקט ב-Container Manager.
# APP_PASSWORD היא סיסמת המנהל בלבד. בחרו עבורה סיסמה ארוכה וייחודית.
# SESSION_SECRET הוא סוד פנימי לחתימת ההתחברויות ואינו סיסמה שמקלידים באתר.
APP_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-a-different-random-string-at-least-32-characters
WACOPY_VOLUME_NAME=maaviron300_wacopy_data
